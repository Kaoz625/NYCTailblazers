# ── Hermes Runtime ──────────────────────────────────────────────────────────
# URL of your Hermes API server
HERMES_API_URL=http://localhost:8642

# API key for authenticating with Hermes
HERMES_API_KEY=

# Which Hermes model to use (e.g. NousResearch/Hermes-3-Llama-3.1-8B)
HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B

# Name shown for the Hermes agent in the 3D office
HERMES_AGENT_NAME=Hermes

# Port the Hermes adapter WebSocket gateway listens on
# (Claw3D-compatible gateway protocol)
HERMES_ADAPTER_PORT=18789

# ── Gateway / Studio ────────────────────────────────────────────────────────
# Build-time gateway URL (baked into client bundle)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# Runtime override – no rebuild needed (takes precedence over NEXT_PUBLIC_*)
HERMES_GATEWAY_URL=ws://localhost:18789

# Token the gateway requires for inbound connections (optional)
HERMES_GATEWAY_TOKEN=

# Protect the studio UI on public / remote deployments
STUDIO_ACCESS_TOKEN=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# Enable debug overlay (set to "true")
DEBUG=

# ── Voice / TTS (optional) ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
