# Self-hosted Supabase config for LLM-Brains
# Copy to .env.supabase and fill in your values
# Then: source .env.supabase  OR  add to your .env file

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-db-password

# ── JWT (generate with: openssl rand -base64 32) ──────────────────────────
JWT_SECRET=your-super-secret-jwt-token-min-32-chars

# ── Supabase API Keys (generate at http://localhost:3000 after first start) ─
# Or generate manually:
#   anon key: JWT with role=anon, signed with JWT_SECRET
#   service role key: JWT with role=service_role, signed with JWT_SECRET
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# ── Public URL (what Claude/clients use to reach Supabase) ────────────────
# Local development:
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# LAN access (replace with your machine's local IP):
# SUPABASE_URL=http://192.168.1.x:8000
# SUPABASE_PUBLIC_URL=http://192.168.1.x:8000

# ── LLM-Brains Supabase integration ───────────────────────────────────────
# Used by src/supabase_sync.py and mcp_server.py
SUPABASE_DB_URL=postgresql://postgres:your-super-secret-db-password@localhost:5432/postgres

# ── Studio ────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
SECRET_KEY_BASE=your-super-secret-key-base-min-64-chars
